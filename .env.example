# Copy to .env (gitignored). Never commit real values.
DATABASE_URL=postgres://lb:lb@localhost:5432/legacy_bridge

# Object storage: an S3-compatible server locally (docker compose service `s3`); on AWS leave S3_ENDPOINT empty and use an instance role (no keys in env).
S3_BUCKET=legacy-bridge
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Sandbox: 'runsc' on Linux worker hosts. 'direct' = NO isolation, dev only, refused when NODE_ENV=production.
LB_SANDBOX=direct

# S2 static native analysis. Build the image locally before enabling the worker.
# LB_ANALYSIS_IMAGE=lb-analysis:f1
# LB_ANALYSIS_RUNTIME=runsc

# Dev auth (header-based, refused in production). Production login arrives in slice S7.
LB_DEV_AUTH=1

# Optional local browser integration for S1. Use only with Next.js bound to loopback.
# NEXT_PUBLIC_LB_S1_UI=1
# LB_S1_ORG_ID=
# LB_S1_USER_ID=

# Optional private Codex analysis demo. The org must exist and allow external models.
# Generate separate random keys (at least 32 characters). Supply only the demo key to the browser.
# LB_CODEX_ORG_ID=
# LB_CODEX_DEMO_KEY=
# LB_CODEX_WORKER_KEY=

# On the processing laptop, set these in the worker shell (see README).
# LB_SITE_URL=https://demo.yourdomain.me
# LB_CODEX_WORKER_KEY=
# LB_REA_ENTRY=C:/path/to/rea-agents/scripts/rea.mjs
# LB_REA_NODE=C:/path/to/node.exe
# LB_CODEX_BIN=C:/path/to/codex.exe
# GHIDRA_INSTALL_DIR=C:/path/to/ghidra
# JAVA_HOME=C:/path/to/jdk

# Module generation worker (S4). Set on the hosting laptop for the two-laptop setup.
# LB_GENERATION_PROVIDER=codex-remote
# LB_GENERATION_MODEL=  # optional; otherwise uses the CLI's built-in model default
# For single-machine development, use LB_GENERATION_PROVIDER=codex and sign in on that machine.

# Login (S7). Auth.js with one generic OIDC provider; sessions are encrypted-JWT cookies. Dev headers (LB_DEV_AUTH=1) stay refused in production.
# AUTH_SECRET=            # 32+ random bytes, e.g. `openssl rand -base64 32`
# AUTH_URL=https://app.example.com
# AUTH_TRUST_HOST=false   # true only behind a trusted proxy
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# First admin: run `npm run bootstrap-admin -- --email you@example.com --org "Your org"` with database access.
