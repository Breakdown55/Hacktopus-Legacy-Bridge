{
  "name": "hacktopus-legacy-bridge",
  "version": "1.0.0",
  "description": "Legacy Bridge turns functionality from legacy executables into reusable code for modern applications, with rerunnable tests to check that it preserves the original behavior.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker": "tsx workers/run.ts",
    "worker:codex": "tsx workers/codex-worker.ts",
    "migrate": "tsx server/db/migrate-cli.ts",
    "bootstrap-admin": "tsx server/db/bootstrap-admin-cli.ts",
    "s1:seed": "tsx server/db/seed-s1.ts",
    "fixtures": "make -C fixtures",
    "demo:prepare": "tsx scripts/demo/prepare.ts",
    "demo:gateway": "tsx scripts/demo/start-gateway.ts",
    "demo:vercel-env": "tsx scripts/demo/vercel-env.ts",
    "demo:tunnel": "tsx scripts/demo/start-tunnel.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Breakdown55/Hacktopus-Legacy-Bridge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Breakdown55/Hacktopus-Legacy-Bridge/issues"
  },
  "homepage": "https://github.com/Breakdown55/Hacktopus-Legacy-Bridge#readme",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "esbuild": "^0.28.2",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
