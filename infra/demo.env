# Hackathon demo: static dev identity, no login. LOCALHOST ONLY: dev headers trust whoever can reach the server.
# Usage: set -a; source infra/demo.env; set +a   (then npm run migrate, npm run s1:seed, npm run dev, npm run worker)
NODE_ENV=development
LB_DEV_AUTH=1
NEXT_PUBLIC_LB_S1_UI=1
LB_S1_ORG_ID=0f5c0000-0000-4000-8000-000000000001
LB_S1_USER_ID=0f5c0000-0000-4000-8000-000000000002
DATABASE_URL=postgres://lb:lb@localhost:5432/legacy_bridge
S3_BUCKET=legacy-bridge
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LB_SANDBOX=direct
LB_WORK_ROOT=/tmp/lb-jobs
LB_ANALYSIS_IMAGE=sha256:8df04a2cbca3dcf26960566b4ba50109e2f2c8adb7601b5ead7cb38dd0bc6030
